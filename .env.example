ENV=dev
DATABASE_URL=postgresql+asyncpg://veda:veda@localhost:5432/veda
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=https://<project-ref>.supabase.co
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Guest gallery address the QR codes encode (the React app). Set to https://<domain>/g in prod.
GALLERY_BASE_URL=http://localhost:5173/g

# S3 (Singapore, next to the database). Use an IAM user allowed only this bucket.
S3_BUCKET=
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
